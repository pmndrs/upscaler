{
    "$schema": "https://json.schemastore.org/tsconfig",
    "compilerOptions": {
        "strict": true,
        "target": "ES2022",
        "module": "ESNext",
        "moduleResolution": "Bundler",
        "esModuleInterop": true,
        "forceConsistentCasingInFileNames": true,
        "skipLibCheck": true,
        "declaration": true,
        "declarationMap": true,
        "sourceMap": true,
        "isolatedModules": true,
        "resolveJsonModule": true,
        "noEmit": true,
        "lib": [
            "ES2022",
            "DOM",
            "DOM.Iterable"
        ],
        "types": [
            "@webgpu/types",
            "vite/client"
        ],
        "baseUrl": ".",
        "paths": {
            "@pmndrs/upscaler": [
                "src/index.ts"
            ],
            "@pmndrs/upscaler/core": [
                "src/core/index.ts"
            ],
            "@pmndrs/upscaler/three": [
                "src/three/index.ts"
            ],
            "@pmndrs/upscaler/babylon": [
                "src/babylon/index.ts"
            ]
        }
    },
    "include": [
        "src",
        "bench/src",
        "examples",
        "test"
    ],
    "exclude": [
        "node_modules",
        "dist",
        "examples/vite.config.ts"
    ]
}
