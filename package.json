{
    "name": "@pmndrs/upscaler",
    "version": "0.5.0",
    "description": "AMD FidelityFX Super Resolution (FSR1 spatial + FSR2/3-style temporal upscaling) for three.js WebGPURenderer, implemented as raw WGSL compute passes",
    "author": "Dennis Smolek <dennis@smolek.dev>",
    "license": "MIT",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/pmndrs/upscaler.git"
    },
    "homepage": "https://github.com/pmndrs/upscaler#readme",
    "bugs": {
        "url": "https://github.com/pmndrs/upscaler/issues"
    },
    "sideEffects": false,
    "keywords": [
        "three",
        "threejs",
        "webgpu",
        "wgsl",
        "fsr",
        "upscale",
        "upscaling",
        "temporal",
        "taa",
        "anti-aliasing",
        "fidelityfx"
    ],
    "type": "module",
    "packageManager": "pnpm@10.33.0",
    "publishConfig": {
        "access": "public"
    },
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "import": "./dist/index.js"
        },
        "./three": {
            "types": "./dist/three.d.ts",
            "import": "./dist/three.js"
        },
        "./core": {
            "types": "./dist/core.d.ts",
            "import": "./dist/core.js"
        },
        "./babylon": {
            "types": "./dist/babylon.d.ts",
            "import": "./dist/babylon.js"
        },
        "./pixi": {
            "types": "./dist/pixi.d.ts",
            "import": "./dist/pixi.js"
        }
    },
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "files": [
        "dist"
    ],
    "scripts": {
        "dev": "vite --config bench/vite.config.ts",
        "bench": "vite --config bench/vite.config.ts",
        "bench:run": "node scripts/run-benchmark.mjs --mode performance",
        "bench:capture": "node scripts/run-benchmark.mjs --mode capture",
        "bench:compare:rcas": "node scripts/compare-rcas.mjs",
        "examples": "vite --config examples/vite.config.ts",
        "examples:build": "vite build --config examples/vite.config.ts",
        "build": "vite build && rollup -c rollup.dts.config.mjs && node scripts/verify-artifacts.mjs",
        "verify:packed-guides": "node scripts/verify-packed-guides.mjs --build-only",
        "verify:packed-guides:gpu": "node scripts/verify-packed-guides.mjs",
        "lint": "eslint .",
        "typecheck": "tsc --noEmit",
        "test": "vitest run",
        "release": "node scripts/release.mjs",
        "prepublishOnly": "pnpm run lint && pnpm run typecheck && pnpm run test && pnpm run build"
    },
    "peerDependencies": {
        "@babylonjs/core": ">=9.31.0 <10",
        "pixi.js": ">=8.22.0 <9",
        "three": ">=0.184.0"
    },
    "peerDependenciesMeta": {
        "@babylonjs/core": {
            "optional": true
        },
        "pixi.js": {
            "optional": true
        },
        "three": {
            "optional": true
        }
    },
    "devDependencies": {
        "@babylonjs/core": "9.31.0",
        "@eslint/js": "^9.18.0",
        "@pmndrs/upscaler-babylon": "workspace:*",
        "@pmndrs/upscaler-core": "workspace:*",
        "@pmndrs/upscaler-pixi": "workspace:*",
        "@pmndrs/upscaler-three": "workspace:*",
        "@types/three": "^0.186.0",
        "@webgpu/types": "^0.1.64",
        "eslint": "^9.18.0",
        "globals": "^15.14.0",
        "lil-gui": "^0.20.0",
        "pixi.js": "8.22.0",
        "rollup": "^4.62.2",
        "rollup-plugin-dts": "^6.2.1",
        "three": "^0.186.1",
        "three-gpu-pathtracer": "https://codeload.github.com/gkjohnson/three-gpu-pathtracer/tar.gz/5f0ad5154a44224ae4b6c801b65778471dabf367",
        "three-mesh-bvh": "^0.9.15",
        "typescript": "^5.7.0",
        "typescript-eslint": "^8.20.0",
        "vite": "^6.1.0",
        "vitest": "^3.0.0"
    }
}
