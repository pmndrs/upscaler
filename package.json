{
    "name": "@pmndrs/upscaler",
    "version": "0.5.0",
    "description": "Renderer-independent WebGPU upscaling with Three.js and Babylon.js Frame Graph adapters",
    "author": "Dennis Smolek <dennis@smolek.dev>",
    "license": "MIT",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/pmndrs/upscaler.git"
    },
    "homepage": "https://github.com/pmndrs/upscaler#readme",
    "bugs": {
        "url": "https://github.com/pmndrs/upscaler/issues"
    },
    "sideEffects": false,
    "keywords": [
        "three",
        "threejs",
        "webgpu",
        "wgsl",
        "fsr",
        "upscale",
        "upscaling",
        "temporal",
        "taa",
        "anti-aliasing",
        "fidelityfx",
        "babylonjs",
        "frame-graph"
    ],
    "type": "module",
    "publishConfig": {
        "access": "public"
    },
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "import": "./dist/index.js"
        },
        "./core": {
            "types": "./dist/core/index.d.ts",
            "import": "./dist/core.js"
        },
        "./three": {
            "types": "./dist/three/index.d.ts",
            "import": "./dist/three.js"
        },
        "./babylon": {
            "types": "./dist/babylon/index.d.ts",
            "import": "./dist/babylon.js"
        }
    },
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "files": [
        "dist",
        "src",
        "NOTICE.md",
        "docs/webgpu-core.md",
        "docs/babylon-framegraph.md",
        "docs/webgpu-validation.md"
    ],
    "scripts": {
        "dev": "vite --config bench/vite.config.ts",
        "bench": "vite --config bench/vite.config.ts",
        "bench:run": "node scripts/run-benchmark.mjs --mode performance",
        "bench:capture": "node scripts/run-benchmark.mjs --mode capture",
        "bench:compare:rcas": "node scripts/compare-rcas.mjs",
        "examples": "vite --config examples/vite.config.ts",
        "examples:build": "vite build --config examples/vite.config.ts",
        "examples:preview": "vite preview --config examples/vite.config.ts",
        "verify:babylon-examples:gpu": "npm run examples:build && node scripts/verify-babylon-examples.mjs",
        "build": "vite build && tsc --declaration --emitDeclarationOnly -p tsconfig.build.json && node scripts/verify-artifacts.mjs",
        "verify:packed-guides": "node scripts/verify-packed-guides.mjs --build-only",
        "verify:packed-guides:gpu": "node scripts/verify-packed-guides.mjs",
        "lint": "eslint .",
        "typecheck": "tsc --noEmit",
        "test": "vitest run",
        "release": "node scripts/release.mjs",
        "prepublishOnly": "npm run lint && npm run typecheck && npm run test && npm run build",
        "verify:packed-entrypoints": "node scripts/verify-packed-entrypoints.mjs",
        "verify:core:gpu": "node scripts/verify-core-gpu.mjs",
        "verify:packed-core:gpu": "npm run build && node scripts/verify-core-gpu.mjs --packed"
    },
    "peerDependencies": {
        "three": ">=0.184.0",
        "@babylonjs/core": "~9.29.0"
    },
    "devDependencies": {
        "@babylonjs/core": "9.29.0",
        "@eslint/js": "^9.18.0",
        "@types/three": "^0.186.0",
        "eslint": "^9.18.0",
        "globals": "^15.14.0",
        "lil-gui": "^0.20.0",
        "three": "^0.186.1",
        "three-gpu-pathtracer": "https://codeload.github.com/gkjohnson/three-gpu-pathtracer/tar.gz/5f0ad5154a44224ae4b6c801b65778471dabf367",
        "three-mesh-bvh": "^0.9.15",
        "typescript": "^5.7.0",
        "typescript-eslint": "^8.20.0",
        "vite": "^6.1.0",
        "vitest": "^3.0.0"
    },
    "peerDependenciesMeta": {
        "three": {
            "optional": true
        },
        "@babylonjs/core": {
            "optional": true
        }
    },
    "dependencies": {
        "@webgpu/types": "^0.1.64"
    }
}
